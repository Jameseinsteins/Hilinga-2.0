rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.id == userId
        && (!('account_mode' in request.resource.data)
          || request.resource.data.account_mode in ['explore', 'business']);
    }

    match /businesses/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'businessScale', 'category', 'location',
          'phone', 'email', 'hours', 'about', 'coverUrl', 'logoUrl',
          'latitude', 'longitude', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.businessScale in ['Small business', 'Big enterprise']
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.hours is string
        && request.resource.data.hours.size() <= 160
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 1500
        && request.resource.data.coverUrl is string
        && request.resource.data.coverUrl.size() <= 450000
        && request.resource.data.logoUrl is string
        && request.resource.data.logoUrl.size() <= 220000
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId);
    }

    function isBusinessAccount() {
      return request.auth != null
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.account_mode == 'business';
    }

    match /touristProfiles/{touristId} {
      allow get: if isOwner(touristId) || isBusinessAccount();
      allow list: if false;
      allow create, update: if isOwner(touristId)
        && request.resource.data.ownerUid == touristId
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'touristCode', 'firstName', 'lastName', 'profilePhoto',
          'language', 'interests',
          'nationality', 'country', 'region', 'province', 'city',
          'verificationStatus', 'qrToken', 'qrStatus', 'consentEnabled',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.touristCode is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.language is string
        && request.resource.data.language.size() > 0
        && request.resource.data.language.size() <= 80
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 30
        && request.resource.data.country is string
        && request.resource.data.qrToken is string
        && request.resource.data.qrToken.size() >= 24
        && request.resource.data.qrToken.size() <= 128
        && request.resource.data.qrStatus in ['active', 'disabled', 'revoked']
        && request.resource.data.consentEnabled is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /touristQrCodes/{token} {
      allow get: if request.auth != null
        && (isBusinessAccount() || resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status in ['active', 'disabled', 'revoked']
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status in ['active', 'disabled', 'revoked']
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /touristVisitLogs/{visitId} {
      allow read: if request.auth != null
        && (resource.data.businessId == request.auth.uid || resource.data.touristId == request.auth.uid);
      allow create: if isBusinessAccount()
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'touristId', 'touristCode', 'touristName', 'touristCountry',
          'touristProvince', 'userLanguage', 'userInterests',
          'businessId', 'businessName', 'businessLocation',
          'qrToken', 'scannedBy', 'visitedAt', 'scanMethod', 'status', 'createdAt'
        ])
        && request.resource.data.touristId is string
        && request.resource.data.touristCode is string
        && request.resource.data.userLanguage is string
        && request.resource.data.userInterests is list
        && request.resource.data.userInterests.size() <= 30
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.businessLocation is string
        && request.resource.data.businessLocation.size() > 0
        && request.resource.data.businessLocation.size() <= 160
        && request.resource.data.qrToken is string
        && request.resource.data.qrToken.size() >= 24
        && request.resource.data.qrToken.size() <= 128
        && request.resource.data.scannedBy == request.auth.uid
        && request.resource.data.scanMethod in ['camera', 'manual']
        && request.resource.data.status == 'recorded'
        && request.resource.data.visitedAt is string
        && request.resource.data.createdAt is string
        && request.resource.data.businessName == get(/databases/$(database)/documents/businesses/$(request.auth.uid)).data.name
        && request.resource.data.businessLocation == get(/databases/$(database)/documents/businesses/$(request.auth.uid)).data.location
        && request.resource.data.touristId == get(/databases/$(database)/documents/touristQrCodes/$(request.resource.data.qrToken)).data.ownerUid
        && get(/databases/$(database)/documents/touristQrCodes/$(request.resource.data.qrToken)).data.status == 'active'
        && request.resource.data.qrToken == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.qrToken
        && get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.qrStatus == 'active'
        && get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.consentEnabled == true
        && request.resource.data.touristCode == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.touristCode
        && request.resource.data.touristCountry == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.country
        && request.resource.data.touristProvince == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.province
        && (
          (!('language' in get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data)
            && request.resource.data.userLanguage == 'English')
          || request.resource.data.userLanguage == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.language
        )
        && (
          (!('interests' in get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data)
            && request.resource.data.userInterests.size() == 0)
          || request.resource.data.userInterests == get(/databases/$(database)/documents/touristProfiles/$(request.resource.data.touristId)).data.interests
        );
      allow update, delete: if false;
    }

    match /users/{userId}/savedPlaces/{placeId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'title', 'subtitle', 'kind', 'imageKey', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() <= 500
        && request.resource.data.kind in [
          'Places', 'Itineraries', 'Businesses', 'Events'
        ]
        && (request.resource.data.imageKey == null
          || request.resource.data.imageKey is string)
        && request.resource.data.createdAt is string;
    }

    match /users/{userId}/tripPlans/{planId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'title', 'preferences', 'itinerary', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.preferences is map
        && request.resource.data.preferences.keys().hasOnly([
          'durationHours', 'budget', 'transportation', 'interests',
          'walkingAbility'
        ])
        && request.resource.data.preferences.durationHours is int
        && request.resource.data.preferences.durationHours >= 1
        && request.resource.data.preferences.durationHours <= 168
        && (request.resource.data.preferences.budget == null
          || request.resource.data.preferences.budget is number)
        && request.resource.data.preferences.transportation is string
        && request.resource.data.preferences.interests is list
        && request.resource.data.preferences.walkingAbility is string
        && request.resource.data.itinerary is list
        && request.resource.data.createdAt is string;
    }

    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorAvatarUrl', 'placeName',
          'location', 'category', 'experience', 'rating', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && (request.resource.data.authorAvatarUrl == null
          || request.resource.data.authorAvatarUrl is string)
        && request.resource.data.placeName is string
        && request.resource.data.placeName.size() > 0
        && request.resource.data.placeName.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 160
        && request.resource.data.category in [
          'Place', 'Restaurant', 'Cafe', 'Accommodation', 'Shop', 'Event',
          'Activity'
        ]
        && request.resource.data.experience is string
        && request.resource.data.experience.size() >= 10
        && request.resource.data.experience.size() <= 1500
        && (request.resource.data.rating == null
          || (request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    match /businessPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'ownerUid', 'sourceId', 'businessId', 'businessName',
          'businessCategory', 'businessLocation', 'businessLogoUrl',
          'category', 'title', 'detail', 'mediaUrl', 'mediaType', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'sourceId', 'businessId', 'businessName',
          'businessCategory', 'businessLocation', 'businessLogoUrl',
          'category', 'title', 'detail', 'mediaUrl', 'mediaType',
          'eventDate', 'eventLocation', 'promotionOffer', 'promotionEnds',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.businessId == 'registered-' + request.auth.uid
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.size() > 0
        && request.resource.data.sourceId.size() <= 128
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.businessCategory is string
        && request.resource.data.businessCategory.size() > 0
        && request.resource.data.businessCategory.size() <= 80
        && request.resource.data.businessLocation is string
        && request.resource.data.businessLocation.size() <= 160
        && request.resource.data.businessLogoUrl is string
        && request.resource.data.businessLogoUrl.size() <= 220000
        && request.resource.data.category in [
          'Photos & Videos', 'Events', 'Promotions'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1500
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.mediaUrl.size() <= 700000
        && request.resource.data.mediaType == 'image'
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /businessPostLikes/{likeId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 160
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /businessInquiries/{inquiryId} {
      allow read: if request.auth != null
        && (resource.data.businessId == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'businessId', 'businessName', 'senderUid', 'senderName',
          'senderEmail', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() > 0
        && request.resource.data.businessName
          == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.name
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail.size() <= 160
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'unread'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && resource.data.businessId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['unread', 'read']
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && (resource.data.businessId == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
    }

    match /businessProfileViews/{viewId} {
      allow read: if request.auth != null
        && resource.data.businessId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'businessId', 'businessName', 'viewerUid', 'viewedAt'
        ])
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.businessId.size() > 0
        && request.resource.data.businessName
          == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.name
        && viewId == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.viewedAt == request.time;
      allow update: if request.auth != null
        && resource.data.viewerUid == request.auth.uid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.businessName == resource.data.businessName
        && request.resource.data.viewerUid == resource.data.viewerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
        && request.resource.data.viewedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
