/**
 * MapScreen Component
 *
 * Manages map display, route planning, live tracking, and navigation.
 * Uses useMapState hook for organized state management and memoization
 * to prevent unnecessary re-renders of expensive route calculations.
 */

import { useCallback, useEffect, useMemo, useState } from "react";
import { MapPlace, MapRouteStop, OpenStreetMap } from "@/components/openstreet-map";
import type { TripPlan, ItineraryDay } from "@/lib/database";
import {
  getTripPlans,
  updateTripPlan,
  getSavedIds,
  removeSavedItem,
  saveItem,
} from "@/lib/cloud-user-data";
import { useMapState } from "@/hooks/useMapState";
import { useAuth } from "@/providers/auth-provider";
import { useDatabase } from "@/providers/database-provider";
import { subscribeToRegisteredBusinesses, RegisteredSmallBusiness } from "@/lib/business-content";

interface MapScreenProps {
  selectedPlanId?: string;
}

export function MapScreen({ selectedPlanId: initialPlanId }: MapScreenProps) {
  const { user } = useAuth();
  const { db } = useDatabase();
  const [state, actions] = useMapState(initialPlanId);
  const [savedIds, setSavedIds] = useState<Set<string>>(new Set());

  // Load plans on mount
  useEffect(() => {
    if (!user?.uid || !db) return;

    actions.setLoadingPlans(true);
    getTripPlans(db, user.uid)
      .then((plans) => {
        actions.setPlans(plans);
        if (initialPlanId && plans.some((p) => p.id === initialPlanId)) {
          actions.setSelectedPlanId(initialPlanId);
        } else if (plans.length > 0) {
          actions.setSelectedPlanId(plans[0].id);
        }
      })
      .catch(() => actions.setRouteError("Failed to load trip plans"))
      .finally(() => actions.setLoadingPlans(false));
  }, [user?.uid, db, initialPlanId]);

  // Load saved items
  useEffect(() => {
    if (!user?.uid || !db) return;
    getSavedIds(db, user.uid)
      .then(setSavedIds)
      .catch(() => {
        /* silent fail */
      });
  }, [user?.uid, db]);

  // Subscribe to registered businesses
  useEffect(() => {
    const unsubscribe = subscribeToRegisteredBusinesses(
      (businesses) => actions.setRegisteredBusinesses(businesses),
      () => {
        /* error handling */
      },
    );
    return () => unsubscribe?.();
  }, []);

  // Get selected plan
  const selectedPlan = useMemo(
    () => state.plans.find((p) => p.id === state.selectedPlanId),
    [state.plans, state.selectedPlanId],
  );

  // Memoize route stops for the active day
  const routeStops = useMemo(() => {
    if (!selectedPlan?.itinerary) return [];
    const day = selectedPlan.itinerary[state.activeDay - 1];
    if (!day) return [];
    return day.stops || [];
  }, [selectedPlan?.itinerary, state.activeDay]);

  // Memoize visible route stops (filtered by completion status)
  const visibleRouteStops = useMemo(() => {
    return routeStops.filter((stop) => !state.completedStops.has(stop.id));
  }, [routeStops, state.completedStops]);

  // Memoize route days for UI display
  const routeDays = useMemo(() => {
    return selectedPlan?.itinerary || [];
  }, [selectedPlan?.itinerary]);

  // Memoize the map center point (center of all stops)
  const mapCenter = useMemo(() => {
    if (visibleRouteStops.length === 0) {
      return [13.1391, 123.7438]; // Default to Legazpi
    }
    const lats = visibleRouteStops.map((s) => s.place.latitude);
    const lngs = visibleRouteStops.map((s) => s.place.longitude);
    const centerLat = (Math.min(...lats) + Math.max(...lats)) / 2;
    const centerLng = (Math.min(...lngs) + Math.max(...lngs)) / 2;
    return [centerLat, centerLng] as [number, number];
  }, [visibleRouteStops]);

  // Memoize terminal selection for routing
  const terminals = useMemo(() => {
    if (visibleRouteStops.length < 2) return [];
    return [
      {
        id: visibleRouteStops[0].id,
        place: visibleRouteStops[0].place,
        label: visibleRouteStops[0].title,
      },
      {
        id: visibleRouteStops[visibleRouteStops.length - 1].id,
        place: visibleRouteStops[visibleRouteStops.length - 1].place,
        label: visibleRouteStops[visibleRouteStops.length - 1].title,
      },
    ];
  }, [visibleRouteStops]);

  // Handle mark stop as done with memoization
  const handleMarkStopDone = useCallback(
    (stop: MapRouteStop) => {
      const newCompleted = new Set(state.completedStops);
      newCompleted.add(stop.id);
      actions.setCompletedStops(newCompleted);

      // Check if all stops are done for this day
      if (newCompleted.size === routeStops.length && routeDays.length > state.activeDay) {
        actions.setCompletedDayPrompt(state.activeDay);
      }
    },
    [state.completedStops, state.activeDay, routeStops.length, routeDays.length, actions],
  );

  // Handle day advance
  const handleProceedToNextDay = useCallback(async () => {
    if (!selectedPlan || !user?.uid) return;

    const nextDay = state.activeDay + 1;
    if (nextDay > routeDays.length) return;

    actions.setActiveDay(nextDay);
    actions.setCompletedStops(new Set());
    actions.setCompletedDayPrompt(null);

    // Persist to cloud
    if (db) {
      try {
        await updateTripPlan(db, user.uid, selectedPlan.id, {
          currentDay: nextDay,
        });
      } catch {
        /* error handling */
      }
    }
  }, [selectedPlan, user?.uid, db, state.activeDay, routeDays.length, actions]);

  // Handle choose destination with memoization
  const handleChooseDestination = useCallback(
    (place: MapPlace) => {
      actions.setDestinationId(place.id || "");
      actions.setDroppedPin(place);
      actions.setShowRoute(true);
    },
    [actions],
  );

  // Handle swap route points
  const handleSwapPoints = useCallback(() => {
    actions.swapRoutePoints();
  }, [actions]);

  // Handle toggle live location
  const handleToggleLiveLocation = useCallback(() => {
    actions.toggleLiveLocation();
  }, [actions]);

  // Handle start navigation
  const handleStartNavigation = useCallback(() => {
    if (visibleRouteStops.length === 0) return;
    actions.setIsNavigating(true);
    actions.setCurrentNavStopIndex(0);
  }, [visibleRouteStops.length, actions]);

  // Handle advance to next stop
  const handleAdvanceNavStop = useCallback(() => {
    const nextIndex = state.currentNavStopIndex + 1;
    if (nextIndex >= visibleRouteStops.length) {
      actions.setIsNavigating(false);
      actions.setNavToast("Route complete!");
      return;
    }
    actions.setCurrentNavStopIndex(nextIndex);
  }, [state.currentNavStopIndex, visibleRouteStops.length, actions]);

  // Handle save item
  const handleSaveItem = useCallback(
    async (item: MapPlace) => {
      if (!user?.uid || !db) return;
      try {
        await saveItem(db, user.uid, "Places", item.id || "", {
          name: item.title || "Place",
          latitude: item.latitude,
          longitude: item.longitude,
        });
        setSavedIds((prev) => new Set([...prev, item.id || ""]));
      } catch {
        actions.setRouteError("Failed to save place");
      }
    },
    [user?.uid, db, actions],
  );

  // Handle remove saved item
  const handleRemoveSavedItem = useCallback(
    async (itemId: string) => {
      if (!user?.uid || !db) return;
      try {
        await removeSavedItem(db, user.uid, "Places", itemId);
        setSavedIds((prev) => {
          const next = new Set(prev);
          next.delete(itemId);
          return next;
        });
      } catch {
        actions.setRouteError("Failed to remove saved place");
      }
    },
    [user?.uid, db, actions],
  );

  if (state.loadingPlans) {
    return (
      <div className="map-screen-loading">
        <p>Loading trip plans...</p>
      </div>
    );
  }

  if (state.plans.length === 0) {
    return (
      <div className="map-screen-empty">
        <p>No trip plans yet. Create one to get started!</p>
      </div>
    );
  }

  return (
    <div className="map-screen">
      {/* Map Display */}
      <div className="map-container">
        <OpenStreetMap
          center={mapCenter}
          zoom={13}
          stops={visibleRouteStops}
          selectedStop={state.isNavigating ? visibleRouteStops[state.currentNavStopIndex] : undefined}
          onSelectPlace={handleChooseDestination}
          onSavePlace={handleSaveItem}
          onRemovePlace={handleRemoveSavedItem}
          registeredBusinesses={state.registeredBusinesses}
          showBusinesses={state.showRegisteredBusinesses}
          showTransport={state.showTransportRoutes}
          liveLocation={state.liveLocation}
          droppedPin={state.droppedPin}
          routeGeometry={state.routeGeometry}
        />
      </div>

      {/* Control Panel */}
      <div className="map-controls">
        {/* Day Selection */}
        <div className="day-selector">
          <label>Day {state.activeDay}</label>
          <div className="day-buttons">
            {routeDays.map((day, index) => (
              <button
                key={index}
                className={`day-btn ${state.activeDay === index + 1 ? "active" : ""}`}
                onClick={() => actions.setActiveDay(index + 1)}
              >
                Day {index + 1}
              </button>
            ))}
          </div>
        </div>

        {/* Route Stops */}
        <div className="stops-list">
          <h3>Stops ({visibleRouteStops.length})</h3>
          {visibleRouteStops.map((stop, index) => (
            <div key={stop.id} className="stop-item">
              <div className="stop-number">{index + 1}</div>
              <div className="stop-info">
                <p className="stop-title">{stop.title}</p>
                {stop.notes && <p className="stop-notes">{stop.notes}</p>}
              </div>
              <button
                className="mark-done-btn"
                onClick={() => handleMarkStopDone(stop)}
              >
                ✓
              </button>
            </div>
          ))}
        </div>

        {/* Navigation Controls */}
        {state.isNavigating && (
          <div className="navigation-panel">
            <h3>Navigation</h3>
            <p>Stop: {state.currentNavStopIndex + 1} / {visibleRouteStops.length}</p>
            <button onClick={handleAdvanceNavStop}>Next Stop →</button>
          </div>
        )}

        {/* Action Buttons */}
        <div className="action-buttons">
          <button
            className="btn btn-primary"
            onClick={handleStartNavigation}
            disabled={visibleRouteStops.length === 0}
          >
            Start Navigation
          </button>
          <button
            className={`btn ${state.liveTracking ? "btn-active" : "btn-secondary"}`}
            onClick={handleToggleLiveLocation}
          >
            {state.liveTracking ? "Live Location On" : "Live Location Off"}
          </button>
          <button
            className="btn btn-secondary"
            onClick={handleSwapPoints}
          >
            Swap Route
          </button>
        </div>

        {/* Error Display */}
        {state.routeError && (
          <div className="error-message">
            <p>{state.routeError}</p>
            <button onClick={() => actions.setRouteError(null)}>×</button>
          </div>
        )}

        {/* Location Error Display */}
        {state.locationError && (
          <div className="error-message">
            <p>{state.locationError}</p>
            <button onClick={() => actions.setLocationError(null)}>×</button>
          </div>
        )}
      </div>

      <style>{`
        .map-screen {
          display: flex;
          flex-direction: column;
          height: 100%;
          gap: 0;
        }

        .map-container {
          flex: 1;
          position: relative;
          min-height: 0;
        }

        .map-screen-loading,
        .map-screen-empty {
          display: flex;
          align-items: center;
          justify-content: center;
          height: 100%;
          color: var(--c-text-secondary, #666);
          font-size: 16px;
        }

        .map-controls {
          background: white;
          border-top: 1px solid var(--c-border, #ddd);
          padding: 16px;
          max-height: 40%;
          overflow-y: auto;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }

        .day-selector {
          display: flex;
          flex-direction: column;
          gap: 8px;
        }

        .day-selector label {
          font-size: 13px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          color: var(--c-text-secondary, #999);
        }

        .day-buttons {
          display: flex;
          gap: 8px;
          overflow-x: auto;
        }

        .day-btn {
          padding: 8px 12px;
          border: 1px solid var(--c-border, #ddd);
          border-radius: 6px;
          background: white;
          font-size: 13px;
          font-weight: 600;
          cursor: pointer;
          white-space: nowrap;
          transition: all 0.2s ease;
        }

        .day-btn:hover {
          border-color: var(--c-primary, #007AFF);
        }

        .day-btn.active {
          background: var(--c-primary, #007AFF);
          color: white;
          border-color: var(--c-primary, #007AFF);
        }

        .stops-list {
          display: flex;
          flex-direction: column;
          gap: 8px;
        }

        .stops-list h3 {
          margin: 0;
          font-size: 14px;
          font-weight: 700;
          color: var(--c-text-primary, #1a1a1a);
        }

        .stop-item {
          display: flex;
          gap: 12px;
          align-items: center;
          padding: 12px;
          background: var(--c-bg-secondary, #f5f5f5);
          border-radius: 8px;
          border: 1px solid var(--c-border, #ddd);
        }

        .stop-number {
          min-width: 24px;
          height: 24px;
          background: var(--c-primary, #007AFF);
          color: white;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 12px;
          font-weight: 700;
        }

        .stop-info {
          flex: 1;
        }

        .stop-title {
          margin: 0;
          font-size: 13px;
          font-weight: 600;
          color: var(--c-text-primary, #1a1a1a);
        }

        .stop-notes {
          margin: 4px 0 0 0;
          font-size: 12px;
          color: var(--c-text-secondary, #666);
        }

        .mark-done-btn {
          background: var(--c-success, #10b981);
          color: white;
          border: none;
          width: 28px;
          height: 28px;
          border-radius: 50%;
          cursor: pointer;
          font-weight: 700;
          transition: all 0.2s ease;
        }

        .mark-done-btn:hover {
          background: var(--c-success-dark, #059669);
        }

        .navigation-panel {
          background: var(--c-primary, #007AFF);
          color: white;
          padding: 12px;
          border-radius: 8px;
        }

        .navigation-panel h3 {
          margin: 0 0 8px 0;
          font-size: 14px;
          font-weight: 700;
        }

        .navigation-panel p {
          margin: 0 0 8px 0;
          font-size: 13px;
        }

        .navigation-panel button {
          background: white;
          color: var(--c-primary, #007AFF);
          border: none;
          padding: 8px 12px;
          border-radius: 6px;
          font-weight: 600;
          cursor: pointer;
          width: 100%;
        }

        .action-buttons {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
        }

        .btn {
          padding: 10px 16px;
          border-radius: 6px;
          border: none;
          font-weight: 600;
          font-size: 13px;
          cursor: pointer;
          transition: all 0.2s ease;
          flex: 1;
          min-width: 100px;
        }

        .btn-primary {
          background: var(--c-primary, #007AFF);
          color: white;
        }

        .btn-primary:hover:not(:disabled) {
          background: var(--c-primary-dark, #0051D5);
        }

        .btn-primary:disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }

        .btn-secondary {
          background: var(--c-border, #ddd);
          color: var(--c-text-primary, #1a1a1a);
        }

        .btn-secondary:hover {
          background: var(--c-border-hover, #ccc);
        }

        .btn-active {
          background: var(--c-success, #10b981) !important;
          color: white;
        }

        .error-message {
          display: flex;
          gap: 8px;
          align-items: center;
          padding: 12px;
          background: var(--c-error-bg, #fee2e2);
          border: 1px solid var(--c-error-border, #fca5a5);
          border-radius: 6px;
          color: var(--c-error, #dc2626);
          font-size: 13px;
        }

        .error-message p {
          margin: 0;
          flex: 1;
        }

        .error-message button {
          background: none;
          border: none;
          color: var(--c-error, #dc2626);
          cursor: pointer;
          font-size: 18px;
          font-weight: 700;
        }

        @media (max-width: 768px) {
          .map-controls {
            max-height: 50%;
          }

          .action-buttons {
            flex-direction: column;
          }

          .btn {
            flex: none;
            width: 100%;
          }
        }
      `}</style>
    </div>
  );
}
