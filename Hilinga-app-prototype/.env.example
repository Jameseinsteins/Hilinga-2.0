VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_STORAGE_ENABLED=false
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_PUBLIC_APP_URL=https://your-hilinga-deployment.example

# Supabase messaging database (free, realtime)
# Get these from https://supabase.com/dashboard -> your project -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Vercel Function settings.
FIREBASE_WEB_API_KEY=your_web_api_key
GEMINI_API_KEY=your_gemini_api_key  # from https://aistudio.google.com/app/apikey (server-only, never VITE_)
GEMINI_MODEL=gemini-3-flash-preview  # fallback: gemini-3-flash-preview
OPENAI_API_KEY=your_server_side_openai_key  # optional fallback
OPENAI_ITINERARY_MODEL=gpt-5.6-luna
