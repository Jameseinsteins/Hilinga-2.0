{
  "name": "hilinga-app-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p ../api/tsconfig.json",
    "preview": "vite preview",
    "autorun": "node scripts/hilinga-autorun.mjs",
    "dev:host": "vite --host --port 5173 --configLoader runner",
    "dev:admin": "vite --host --port 5174 --configLoader runner --open admin.html",
    "dev:all": "vite --host --port 5173 --configLoader runner & vite --host --port 5174 --configLoader runner",
    "build:admin": "tsc -b && vite build --configLoader runner",
    "preview:admin": "vite preview --host --port 4174 --configLoader runner"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "@types/leaflet": "^1.9.20",
    "@types/qrcode": "^1.5.6",
    "exceljs": "^4.4.0",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
