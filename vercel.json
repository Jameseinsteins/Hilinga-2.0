{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix Hilinga-app-prototype ci",
  "buildCommand": "npm --prefix Hilinga-app-prototype run build",
  "outputDirectory": "Hilinga-app-prototype/dist",
  "functions": {
    "api/itinerary.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/itinerary-chat.ts": {
      "maxDuration": 60
    }
  }
}
